{
  "name": "IntegracaoConfig",
  "type": "object",
  "properties": {
    "chave": {
      "type": "string",
      "title": "Chave (singleton)",
      "default": "default"
    },
    "cnpj_ativo": {
      "type": "boolean",
      "title": "Consulta de CNPJ (BrasilAPI)",
      "default": true
    },
    "cep_ativo": {
      "type": "boolean",
      "title": "Consulta de CEP (ViaCEP)",
      "default": true
    },
    "datajud_ativo": {
      "type": "boolean",
      "title": "Consulta ao DataJud (CNJ)",
      "default": false
    },
    "datajud_tribunal": {
      "type": "string",
      "title": "Tribunal DataJud",
      "default": "trt2"
    },
    "datajud_size": {
      "type": "number",
      "title": "Qtd. de processos por busca",
      "default": 5
    },
    "template_docx_url": {
      "type": "string",
      "title": "URL do template .docx (docxtemplater)"
    },
    "template_docx_nome": {
      "type": "string",
      "title": "Nome do arquivo do template .docx"
    },
    "cct_ativo": {
      "type": "boolean",
      "title": "Consulta de CCT (cct-api)",
      "default": true
    },
    "cct_categoria": {
      "type": "string",
      "title": "Categoria da CCT (vazio = auto por fun\u00e7\u00e3o)",
      "enum": [
        "",
        "vigilancia",
        "terceirizados",
        "asseio_conservacao"
      ],
      "default": ""
    }
  },
  "required": [
    "chave"
  ]
}